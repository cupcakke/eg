export const ACTION_REGISTRY =
	cut: {icon: 'scissors', title: 'Cut', shortcut: 'X'}
	copy: {icon: 'clipboard', title: 'Copy', shortcut: 'C'}
	paste: {icon: 'clipboard', title: 'Paste', shortcut: 'V'}
	duplicate: {icon: 'duplicate', title: 'Duplicate', shortcut: 'D'}
	delete: {icon: 'trash', title: 'Delete', destructive: yes}
	share: {icon: 'share', title: 'Share…'}
	rename: {icon: 'pencil', title: 'Rename'}
	favorite: {icon: 'star', title: 'Favorite'}
	'select-all': {icon: 'list', title: 'Select All', shortcut: 'A'}
	find: {icon: 'search', title: 'Find…', shortcut: 'F'}
	'new-folder': {icon: 'folder', title: 'New Folder'}
	move: {icon: 'doc', title: 'Move To…'}
	pin: {icon: 'pin', title: 'Pin'}
	download: {icon: 'download', title: 'Download'}
	upload: {icon: 'upload', title: 'Upload'}
	refresh: {icon: 'refresh', title: 'Refresh'}
	info: {icon: 'info', title: 'Get Info'}
	settings: {icon: 'gear', title: 'Settings…'}

export def symbolPaths name
	let found = SYMBOLS[name]
	if found then found else []

export def actionInfo action
	let found = ACTION_REGISTRY[action]
	if found then found else {icon: 'ellipsis', title: action}

export def svgMarkup name, weight = 'regular', scale = 'medium'
	let sw = SYMBOL_WEIGHTS[weight] or 1.7
	let sc = SYMBOL_SCALES[scale] or 1.0
	let size = Math.round(24 * sc * 100) / 100
	let paths = symbolPaths name
	let d = ''
	for p in paths
		d += "<path d='{p}'/>"
	"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='currentColor' stroke-width='{sw}' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>{d}</svg>"

tag gk-icon
	prop name = ''
	prop weight = 'regular'
	prop scale = 'medium'
	prop label = null

	def render
		let sw = SYMBOL_WEIGHTS[weight] or 1.7
		let sc = SYMBOL_SCALES[scale] or 1.0
		let size = Math.round(24 * sc * 100) / 100
		<self role=(label != null ? 'img' : null) aria-label=label aria-hidden=(label == null ? 'true' : null)>
			<svg viewBox='0 0 24 24' width=size height=size fill='none' stroke='currentColor' stroke-width=sw stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
				for p in symbolPaths(name)
					<path d=p>
